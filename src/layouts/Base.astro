---
import "../styles/global.css";
import { pageTitle } from "../components/page-title";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const owner = Astro.locals.owner;
const csrfToken = Astro.locals.csrfToken ?? "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title)}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <header class="site-header">
      <a class="brand" href="/">
        Willycrumbs
      </a>
      {owner && (
        <nav class="site-nav" aria-label="Main">
          <a href="/">Meetings</a>
          <a href="/search">Search</a>
          <a href="/settings/templates">Templates</a>
          <a href="/settings/folders">Folders</a>
        </nav>
      )}
      {owner && (
        <div class="session">
          <span>Signed in as {owner.displayName}</span>
          <form method="post" action="/sign-out">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <button class="button button-quiet" type="submit">
              Sign out
            </button>
          </form>
        </div>
      )}
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Capture only with everyone's consent.</p>
    </footer>
  </body>
</html>
