---
import "../styles/global.css";
import { pageTitle } from "../components/page-title";
import { NAV_LINKS, currentNavHref } from "../components/nav-current";

interface Props {
  title?: string;
}

const { title } = Astro.props;
const owner = Astro.locals.owner;
const csrfToken = Astro.locals.csrfToken ?? "";
const current = currentNavHref(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle(title)}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <header class="site-header">
      <a class="brand" href="/">
        Willycrumbs
      </a>
      {owner && (
        <nav class="site-nav" aria-label="Main">
          {NAV_LINKS.map((link) => (
            <a href={link.href} aria-current={link.href === current ? "page" : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      )}
      {owner && (
        <div class="session">
          <span class="session-name">Signed in as {owner.displayName}</span>
          <form method="post" action="/sign-out">
            <input type="hidden" name="csrf_token" value={csrfToken} />
            <button class="button button-quiet" type="submit">
              Sign out
            </button>
          </form>
        </div>
      )}
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Capture only with everyone's consent.</p>
    </footer>
  </body>
</html>
