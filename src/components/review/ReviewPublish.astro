---
import { t } from "../../i18n/translate";
import type { MeetingStatus } from "../../domain/meetings/lifecycle";
import type { ReviewView } from "../../ports/review-repository";
import { formatSchedule } from "../format-schedule";
import type { ErrorsFor, Typed } from "./types";

/**
 * Publishing, in the two places it lives. A draft that can be published is a bar that stays at
 * the bottom of the viewport (`bar`): "Publish to folder" opens the form (private folder and the
 * confirmation, unchanged) in place, so nothing is lost without JavaScript; the page renders it
 * open again when the server rejected the form (`formOpen`). Every other state is a quiet section
 * in the reading column: Published with its Reopen form, a draft with no folder yet, a draft that
 * cannot be published. Whether the note may be edited is decided by the page.
 */
interface Props {
  /** The review page's own path: the target of every form. */
  base: string;
  csrf: string;
  editable: boolean;
  /** Render the sticky bar (a draft with at least one folder); the page places it last. */
  bar: boolean;
  /** The publish form was rejected: keep it open so the errors are on screen. */
  formOpen: boolean;
  note: NonNullable<ReviewView["note"]>;
  meeting: { status: MeetingStatus; timezone: string };
  /** The owner's folders: where a note can be filed when it is published. */
  folders: readonly { id: string; name: string }[];
  typed: Typed;
  errorsFor: ErrorsFor;
}

const { base, csrf, editable, bar, formOpen, note, meeting, folders, typed, errorsFor } =
  Astro.props;

// One whole sentence per combination, never pieces joined (docs/I18N.md 3b).
const publishedLine = (): string => {
  const folder = note.folderName;
  const date =
    note.publishedAt === null ? null : formatSchedule(note.publishedAt, meeting.timezone);
  if (folder !== null && date !== null)
    return t("Published to {folder} on {date}.", { folder, date });
  if (folder !== null) return t("Published to {folder}.", { folder });
  if (date !== null) return t("Published on {date}.", { date });
  return t("Published.");
};
---

{bar ? (
  <section class="publish-bar review-cols" id="publish" aria-labelledby="publish-heading">
    <h2 id="publish-heading" class="sr-only">
      {t("Publish")}
    </h2>
    <details class="publish-details" open={formOpen}>
      <summary>
        <span class="publish-state">{t("Draft, not published")}</span>
        <span class="publish-action">{t("Publish to folder")}</span>
      </summary>
      <form method="post" action={base} class="form form-wide publish-form">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="intent" value="publish" />
        <p>
          {t(
            "This is a draft generated from the transcript. It stays a draft until you publish it.",
          )}
        </p>
        <div class="field field-wide">
          <label for="publish-folder">{t("Private folder")}</label>
          <select
            id="publish-folder"
            name="folder"
            required
            aria-describedby="publish-folder-error"
          >
            {folders.map((f) => (
              <option
                value={f.id}
                selected={typed("publish", "folder", note.folderId ?? "") === f.id}
              >
                {f.name}
              </option>
            ))}
          </select>
          {errorsFor("publish", "folder").map((e) => (
            <p class="field-error" id="publish-folder-error">
              {e.message}
            </p>
          ))}
        </div>
        <div class="check">
          <input
            id="publish-confirm"
            name="confirm"
            type="checkbox"
            aria-describedby="publish-confirm-help"
          />
          <label for="publish-confirm">
            {t("I have reviewed this note and want to publish it.")}
          </label>
        </div>
        {errorsFor("publish", "confirm").map((e) => (
          <p class="field-error">{e.message}</p>
        ))}
        <p id="publish-confirm-help" class="help">
          {t(
            "Publishing locks the note until you reopen it. It is never shared outside your folder.",
          )}
        </p>
        <div class="row-actions">
          <button class="button" type="submit">
            {t("Publish to folder")}
          </button>
        </div>
      </form>
    </details>
  </section>
) : (
  <section class="review-status" id="publish" aria-labelledby="publish-heading">
    <h2 id="publish-heading">{note.status === "published" ? t("Published") : t("Publish")}</h2>
    {note.status === "published" && (
      <>
        <p>
          {publishedLine()} {t("This version is read-only.")}
        </p>
        <form method="post" action={base} class="form form-wide">
          <input type="hidden" name="csrf_token" value={csrf} />
          <input type="hidden" name="intent" value="reopen" />
          <p class="help">
            {t(
              "Reopening turns it back into a draft so you can edit it. " +
                "It stays unpublished until you publish again.",
            )}
          </p>
          <div class="row-actions">
            <button class="button button-quiet" type="submit">
              {t("Reopen for editing")}
            </button>
          </div>
        </form>
      </>
    )}
    {editable && folders.length === 0 && (
      <p>
        {t("Publishing files the note in a private folder, and you have none yet.")}{" "}
        <a href="/folders">{t("Create a folder")}</a>. {t("Then come back: your edits stay here.")}
      </p>
    )}
    {note.status === "draft" && !editable && (
      <p>
        {meeting.status === "archived"
          ? t("This note is archived.")
          : t("This note is not ready to publish.")}
      </p>
    )}
  </section>
)}
