---
import { t } from "../../i18n/translate";
import { describeJob } from "../../domain/progress/text";
import type { ReviewSection } from "../../ports/review-repository";
import ReviewOutline from "./ReviewOutline.astro";
import ReviewSource from "./ReviewSource.astro";
import type { ErrorsFor, IsHit, Regeneration, SourceLinkFor, Typed } from "./types";

/**
 * The summary as an outline: the whole-draft regeneration disclosure, then each section as a
 * heading and read-only text (paragraphs and real lists), with its source chip, an Edit link and
 * a quiet regenerate disclosure. Only the section named by `editingId` shows its edit form.
 * Markup only: the page decides what is editable and what is highlighted.
 */
interface Props {
  meetingId: string;
  /** The review page's own path: the target of the edit forms and the "Check again" links. */
  base: string;
  csrf: string;
  editable: boolean;
  sections: readonly ReviewSection[];
  /** The section open for editing (`?edit=<id>`), or null: every other section stays read-only. */
  editingId: string | null;
  /** The latest regeneration of any scope, shown under the section it belongs to. */
  regeneration: Regeneration | null;
  /** The whole-draft request while it is not done: opens the disclosure and shows its line. */
  draftRegeneration: Regeneration | null;
  isHit: IsHit;
  sourceLink: SourceLinkFor;
  typed: Typed;
  errorsFor: ErrorsFor;
}

const {
  meetingId,
  base,
  csrf,
  editable,
  sections,
  editingId,
  regeneration,
  draftRegeneration,
  isHit,
  sourceLink,
  typed,
  errorsFor,
} = Astro.props;
---

<h2>{t("Meeting summary")}</h2>
{editable && (
  <details class="regenerate-draft" id="regenerate-draft" open={draftRegeneration !== null}>
    <summary>{t("Regenerate whole draft")}</summary>
    <form
      method="post"
      action={`/meetings/${meetingId}/note/regenerate-all`}
      class="form form-wide regenerate-draft-form"
    >
      <input type="hidden" name="csrf_token" value={csrf} />
      <p class="help" id="regenerate-draft-help">
        {t(
          "Writes the summary again from the transcript. It replaces every section, decision and " +
            "action item, including your edits to them. Your rough notes, the transcript and the " +
            "speaker names are kept, and the note stays a draft until you publish it.",
        )}
      </p>
      <div class="check">
        <input
          id="regenerate-draft-confirm"
          name="confirm"
          type="checkbox"
          required
          aria-describedby="regenerate-draft-help"
        />
        <label for="regenerate-draft-confirm">{t("Replace my edits with a new draft.")}</label>
      </div>
      <div class="row-actions">
        <button class="button button-quiet" type="submit">
          {t("Regenerate whole draft")}
        </button>
      </div>
    </form>
    {draftRegeneration !== null && (
      <p
        class="help"
        role="status"
        data-progress="regeneration"
        data-scope="all"
        data-progress-url={`/api/meetings/${meetingId}/status`}
      >
        <span data-field="text">
          {t("Regeneration: {status}.", { status: describeJob(draftRegeneration) })}
        </span>{" "}
        <span data-field="outcome" data-optional hidden /> <a href={base}>{t("Check again")}</a>
      </p>
    )}
  </details>
)}
{sections.length === 0 && <p class="empty">{t("The summary has no sections.")}</p>}
<div class="outline">
  {sections.map((s) => {
    const source = sourceLink(s.sourceFrom, s.sourceTo);
    const regen = regeneration !== null && regeneration.sectionId === s.id ? regeneration : null;
    const regenerating = regen !== null && regen.status !== "succeeded";
    const editing = editable && editingId === s.id;
    const bodyErrors = errorsFor(s.id, "body");
    return (
      <section
        class:list={["outline-section", { "is-hit": isHit("note_section", s.id) }]}
        id={`section-${s.id}`}
        aria-labelledby={`heading-${s.id}`}
      >
        <h3 id={`heading-${s.id}`}>{s.heading}</h3>
        {(s.edited || isHit("note_section", s.id)) && (
          <p class="outline-marks">
            {s.edited && <span class="outline-mark">{t("Edited by you")}</span>}
            {isHit("note_section", s.id) && <span class="badge">{t("Search match")}</span>}
          </p>
        )}
        {editing ? (
          <form method="post" action={`${base}?edit=${s.id}`} class="outline-edit">
            <input type="hidden" name="csrf_token" value={csrf} />
            <input type="hidden" name="intent" value="edit_section" />
            <input type="hidden" name="id" value={s.id} />
            <div class="field field-wide">
              <label class="sr-only" for={`body-${s.id}`}>
                {t("Text of “{heading}”", { heading: s.heading })}
              </label>
              <textarea
                id={`body-${s.id}`}
                name="body"
                rows="4"
                maxlength="20000"
                autofocus
                data-autogrow
                aria-invalid={bodyErrors.length > 0 ? "true" : undefined}
                aria-describedby={bodyErrors.length > 0 ? `body-error-${s.id}` : undefined}
              >{`\n${typed(s.id, "body", s.body)}`}</textarea>
              {bodyErrors.map((e) => (
                <p class="field-error" id={`body-error-${s.id}`}>
                  {e.message}
                </p>
              ))}
            </div>
            <div class="outline-actions">
              <button class="button" type="submit">
                {t("Save")}
                <span class="sr-only"> {t("section {heading}", { heading: s.heading })}</span>
              </button>
              <a class="outline-link" href={`${base}#section-${s.id}`}>
                {t("Cancel")}
                <span class="sr-only"> {t("editing {heading}", { heading: s.heading })}</span>
              </a>
            </div>
          </form>
        ) : (
          <ReviewOutline body={s.body} />
        )}
        {!editing && (
          <div class="outline-actions">
            <ReviewSource source={source} chip />
            {editable && (
              <a class="outline-link" href={`${base}?edit=${s.id}#section-${s.id}`}>
                {t("Edit")}
                <span class="sr-only"> {t("section {heading}", { heading: s.heading })}</span>
              </a>
            )}
            {editable && (
              <details class="outline-menu" open={regenerating}>
                <summary>
                  {t("Regenerate")}
                  <span class="sr-only"> {t("section {heading}", { heading: s.heading })}</span>
                </summary>
                <form
                  method="post"
                  action={`/meetings/${meetingId}/note/regenerate`}
                  class="outline-menu-form"
                >
                  <input type="hidden" name="csrf_token" value={csrf} />
                  <input type="hidden" name="section_id" value={s.id} />
                  <p class="help">
                    {t(
                      "Replaces only this section with a new draft from the transcript, " +
                        "including your edits to it.",
                    )}
                  </p>
                  <button class="button button-quiet" type="submit">
                    {t("Regenerate this section")}
                    <span class="sr-only">{t(": {text}", { text: s.heading })}</span>
                  </button>
                </form>
              </details>
            )}
          </div>
        )}
        {regenerating && (
          <p
            class="help"
            role="status"
            data-progress="regeneration"
            data-progress-url={`/api/meetings/${meetingId}/status`}
            data-section-id={s.id}
          >
            <span data-field="text">
              {t("Regeneration: {status}.", { status: describeJob(regen) })}
            </span>{" "}
            <span data-field="outcome" data-optional hidden /> <a href={base}>{t("Check again")}</a>
          </p>
        )}
      </section>
    );
  })}
</div>
