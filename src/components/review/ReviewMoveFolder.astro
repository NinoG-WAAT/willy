---
import type { FieldError } from "../../domain/platform/text";

/**
 * The review's "Move to folder" control of a published note. It goes into the `move` slot of
 * MeetingHeader, right under the folder chip it changes (the page decides whether it is shown).
 */
interface Props {
  /** The review page's own path: the target of the form. */
  base: string;
  csrf: string;
  /** The owner's other folders; none means there is nowhere to move the note. */
  moveTargets: readonly { id: string; name: string }[];
  /** Errors of the rejected move form; they open the control. */
  moveErrors: readonly FieldError[];
}

const { base, csrf, moveTargets, moveErrors } = Astro.props;
---

<details class="move-folder" open={moveErrors.length > 0}>
  {/* The redirect after a move lands here, so focus returns to the control it was used from. */}
  <summary id="move-folder">Move to folder</summary>
  {moveTargets.length === 0 ? (
    <p class="help move-folder-form">
      You have no other folder to move this note to. <a href="/folders">Create a folder</a>.
    </p>
  ) : (
    <form method="post" action={base} class="form form-wide move-folder-form">
      <input type="hidden" name="csrf_token" value={csrf} />
      <input type="hidden" name="intent" value="move_note" />
      <div class="field field-wide">
        <label for="move-folder-select">Move this note to</label>
        <select
          id="move-folder-select"
          name="folder"
          required
          aria-describedby="move-folder-help move-folder-error"
        >
          {moveTargets.map((f) => (
            <option value={f.id}>{f.name}</option>
          ))}
        </select>
        {moveErrors.map((e) => (
          <p class="field-error" id="move-folder-error">
            {e.message}
          </p>
        ))}
      </div>
      <p id="move-folder-help" class="help">
        The note stays published and keeps its content. Only its folder changes.
      </p>
      <div class="row-actions">
        <button class="button" type="submit">
          Move
        </button>
      </div>
    </form>
  )}
</details>
