---
import { t } from "../../i18n/translate";
import { actionItemChips } from "../../domain/notes/action-chips";
import { dueDateInputValue } from "../../domain/notes/review";
import type { ReviewActionItem } from "../../ports/review-repository";
import ReviewSource from "./ReviewSource.astro";
import type { Checked, ErrorsFor, IsHit, SourceLinkFor, Typed } from "./types";

/**
 * The action items of the note as a checklist outline: a done checkbox, the text, quiet chips for
 * assignee, due date, overdue (in words) and source, and an Edit link. Only the item named by
 * `?edit=` (or the one whose save was just rejected) shows its form; adding one lives behind a
 * disclosure. Assignees are the meeting's Attendees. Everything is text nodes, never raw HTML.
 */
interface Props {
  /** The review page's own path: the target of every form. */
  base: string;
  csrf: string;
  editable: boolean;
  actionItems: readonly ReviewActionItem[];
  /** The `edit` query value. Only compared with the ids on this page, never rendered. */
  editingId: string | null;
  attendees: readonly { id: string; name: string }[];
  /** The meeting's IANA zone: the default zone of a due date. */
  timezone: string;
  /** The page's clock, so overdue is decided once per request and never read here. */
  now: Date;
  isHit: IsHit;
  sourceLink: SourceLinkFor;
  typed: Typed;
  checked: Checked;
  errorsFor: ErrorsFor;
}

const {
  base,
  csrf,
  editable,
  actionItems,
  editingId,
  attendees,
  timezone,
  now,
  isHit,
  sourceLink,
  typed,
  checked,
  errorsFor,
} = Astro.props;

const attendeeNames = new Map(attendees.map((a) => [a.id, a.name]));
const FIELDS = ["text", "assignee", "due"] as const;
const addErrors = FIELDS.flatMap((f) => errorsFor("add_action_item", f));
---

<section class="panel review-lists" id="action-items" aria-labelledby="actions-heading">
  <h2 id="actions-heading">{t("Action items")}</h2>
  {actionItems.length === 0 && <p>{t("No action items were recorded.")}</p>}
  {actionItems.length > 0 && (
    <ul class="rl-list rl-checklist">
      {actionItems.map((a) => {
        const key = a.id;
        const chips = actionItemChips(a, {
          now,
          meetingTimezone: timezone,
          attendeeNames,
        });
        const zone = a.dueTimezone ?? timezone;
        const hasErrors = FIELDS.some((f) => errorsFor(key, f).length > 0);
        const editing = editable && (editingId === a.id || hasErrors);
        const isDone = a.status === "done";
        return (
          <li
            id={`action-${a.id}`}
            class:list={[
              "rl-item",
              { "is-hit": isHit("action_item", a.id), "is-editing": editing, "is-done": isDone },
            ]}
          >
            {editing ? (
              <>
                <form method="post" action={base} class="form form-wide">
                  <input type="hidden" name="csrf_token" value={csrf} />
                  <input type="hidden" name="intent" value="edit_action_item" />
                  <input type="hidden" name="id" value={a.id} />
                  <div class="field field-wide">
                    <label for={`act-text-${a.id}`}>{t("Action")}</label>
                    <input
                      id={`act-text-${a.id}`}
                      name="text"
                      type="text"
                      maxlength="2000"
                      value={typed(key, "text", a.text)}
                      aria-invalid={errorsFor(key, "text").length > 0 ? "true" : undefined}
                      aria-describedby={
                        errorsFor(key, "text").length > 0 ? `act-text-error-${a.id}` : undefined
                      }
                      autofocus
                    />
                    {errorsFor(key, "text").map((e) => (
                      <p class="field-error" id={`act-text-error-${a.id}`}>
                        {e.message}
                      </p>
                    ))}
                  </div>
                  <div class="field-group">
                    <div class="field">
                      <label for={`act-owner-${a.id}`}>{t("Owner")}</label>
                      <select
                        id={`act-owner-${a.id}`}
                        name="assignee"
                        aria-invalid={errorsFor(key, "assignee").length > 0 ? "true" : undefined}
                        aria-describedby={
                          errorsFor(key, "assignee").length > 0
                            ? `act-owner-error-${a.id}`
                            : undefined
                        }
                      >
                        <option
                          value=""
                          selected={typed(key, "assignee", a.assigneeId ?? "") === ""}
                        >
                          {t("No owner")}
                        </option>
                        {attendees.map((p) => (
                          <option
                            value={p.id}
                            selected={typed(key, "assignee", a.assigneeId ?? "") === p.id}
                          >
                            {p.name}
                          </option>
                        ))}
                      </select>
                      {errorsFor(key, "assignee").map((e) => (
                        <p class="field-error" id={`act-owner-error-${a.id}`}>
                          {e.message}
                        </p>
                      ))}
                    </div>
                    <div class="field">
                      <label for={`act-due-${a.id}`}>
                        {t("Due date ({timezone})", { timezone })}
                      </label>
                      <input
                        id={`act-due-${a.id}`}
                        name="due"
                        type="date"
                        value={typed(key, "due", dueDateInputValue(a.dueAt, zone))}
                        aria-invalid={errorsFor(key, "due").length > 0 ? "true" : undefined}
                        aria-describedby={
                          errorsFor(key, "due").length > 0 ? `act-due-error-${a.id}` : undefined
                        }
                      />
                      {errorsFor(key, "due").map((e) => (
                        <p class="field-error" id={`act-due-error-${a.id}`}>
                          {e.message}
                        </p>
                      ))}
                    </div>
                  </div>
                  <div class="check">
                    <input
                      id={`act-done-${a.id}`}
                      name="done"
                      type="checkbox"
                      checked={checked(key, "done", isDone)}
                    />
                    <label for={`act-done-${a.id}`}>{t("Done")}</label>
                  </div>
                  <div class="row-actions">
                    <button class="button" type="submit">
                      {t("Save action item")}
                      <span class="sr-only">{t(": {text}", { text: a.text })}</span>
                    </button>
                    <a href={`${base}#action-${a.id}`}>
                      {t("Cancel")}
                      <span class="sr-only"> {t("editing this action item")}</span>
                    </a>
                  </div>
                </form>
                <details class="rl-remove">
                  <summary>{t("Remove this action item")}</summary>
                  <form method="post" action={base} class="form">
                    <input type="hidden" name="csrf_token" value={csrf} />
                    <input type="hidden" name="intent" value="delete_action_item" />
                    <input type="hidden" name="id" value={a.id} />
                    <p class="help">
                      {t(
                        "Removes only this action item from the draft. The transcript is untouched.",
                      )}
                    </p>
                    <div class="row-actions">
                      <button class="button button-danger" type="submit">
                        {t("Confirm: remove action item")}
                      </button>
                    </div>
                  </form>
                </details>
              </>
            ) : (
              <div class="rl-line">
                {editable ? (
                  <form method="post" action={base} class="rl-done check">
                    <input type="hidden" name="csrf_token" value={csrf} />
                    <input type="hidden" name="intent" value="set_action_item_done" />
                    <input type="hidden" name="id" value={a.id} />
                    <input
                      id={`act-done-${a.id}`}
                      class="rl-done-box"
                      name="done"
                      type="checkbox"
                      checked={isDone}
                    />
                    <label class="sr-only" for={`act-done-${a.id}`}>
                      {t("Mark done: {text}", { text: a.text })}
                    </label>
                    <button class="button-quiet rl-done-save" type="submit">
                      {t("Save status")}
                      <span class="sr-only">{t(": {text}", { text: a.text })}</span>
                    </button>
                  </form>
                ) : (
                  <span class="rl-state">{isDone ? t("Done") : t("Open")}</span>
                )}
                <span class="rl-text">
                  {isDone && <span class="sr-only">{t("Done:")} </span>}
                  {a.text}
                </span>
                <span class="rl-meta">
                  {isHit("action_item", a.id) && <span class="badge">{t("Search match")}</span>}
                  {chips.assignee !== null && (
                    <span class="rl-chip">
                      <span class="sr-only">{t("Owner:")} </span>
                      {chips.assignee}
                    </span>
                  )}
                  {chips.due !== null && a.dueAt !== null && (
                    <span class="rl-chip">
                      <time datetime={a.dueAt} title={t("In {zone}", { zone })}>
                        {chips.due}
                      </time>
                    </span>
                  )}
                  {chips.overdue !== null && (
                    <span class="rl-chip rl-chip-overdue">{chips.overdue}</span>
                  )}
                  <ReviewSource source={sourceLink(a.sourceFrom, a.sourceTo)} chip />
                  {a.edited && <span class="rl-chip">{t("Edited by you")}</span>}
                  {editable && (
                    <a class="rl-edit" href={`${base}?edit=${a.id}#action-${a.id}`}>
                      {t("Edit")}
                      <span class="sr-only"> {t("action item: {text}", { text: a.text })}</span>
                    </a>
                  )}
                </span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )}
  {editable && (
    <details class="rl-add" open={addErrors.length > 0}>
      <summary>{t("Add an action item")}</summary>
      <form method="post" action={base} class="form form-wide">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="intent" value="add_action_item" />
        <div class="field field-wide">
          <label for="new-action">{t("Action")}</label>
          <input
            id="new-action"
            name="text"
            type="text"
            maxlength="2000"
            value={typed("add_action_item", "text", "")}
            aria-invalid={errorsFor("add_action_item", "text").length > 0 ? "true" : undefined}
            aria-describedby={
              errorsFor("add_action_item", "text").length > 0 ? "new-action-error" : undefined
            }
          />
          {errorsFor("add_action_item", "text").map((e) => (
            <p class="field-error" id="new-action-error">
              {e.message}
            </p>
          ))}
        </div>
        <div class="field-group">
          <div class="field">
            <label for="new-action-owner">{t("Owner")}</label>
            <select
              id="new-action-owner"
              name="assignee"
              aria-invalid={
                errorsFor("add_action_item", "assignee").length > 0 ? "true" : undefined
              }
              aria-describedby={
                errorsFor("add_action_item", "assignee").length > 0
                  ? "new-action-owner-error"
                  : undefined
              }
            >
              <option value="">{t("No owner")}</option>
              {attendees.map((p) => (
                <option value={p.id} selected={typed("add_action_item", "assignee", "") === p.id}>
                  {p.name}
                </option>
              ))}
            </select>
            {errorsFor("add_action_item", "assignee").map((e) => (
              <p class="field-error" id="new-action-owner-error">
                {e.message}
              </p>
            ))}
          </div>
          <div class="field">
            <label for="new-action-due">{t("Due date ({timezone})", { timezone })}</label>
            <input
              id="new-action-due"
              name="due"
              type="date"
              value={typed("add_action_item", "due", "")}
              aria-invalid={errorsFor("add_action_item", "due").length > 0 ? "true" : undefined}
              aria-describedby={
                errorsFor("add_action_item", "due").length > 0 ? "new-action-due-error" : undefined
              }
            />
            {errorsFor("add_action_item", "due").map((e) => (
              <p class="field-error" id="new-action-due-error">
                {e.message}
              </p>
            ))}
          </div>
        </div>
        <div class="row-actions">
          <button class="button button-quiet" type="submit">
            {t("Add action item")}
          </button>
        </div>
      </form>
      {attendees.length === 0 && (
        <p class="help">
          {t("This meeting has no attendees, so action items cannot have an owner.")}
        </p>
      )}
    </details>
  )}
</section>

<script>
  import "../../scripts/review-lists";
</script>
