---
import { t } from "../../i18n/translate";
import type { ReviewDecision } from "../../ports/review-repository";
import ReviewSource from "./ReviewSource.astro";
import type { ErrorsFor, IsHit, SourceLinkFor, Typed } from "./types";

/**
 * The decisions of the note as a plain outline: text, a source chip and an Edit link per line.
 * Only the decision named by `?edit=` (or the one whose save was just rejected) shows its form;
 * adding one lives behind a disclosure. Everything is text nodes: nothing here is ever raw HTML.
 */
interface Props {
  /** The review page's own path: the target of every form. */
  base: string;
  csrf: string;
  editable: boolean;
  decisions: readonly ReviewDecision[];
  /** The `edit` query value. Only compared with the ids on this page, never rendered. */
  editingId: string | null;
  isHit: IsHit;
  sourceLink: SourceLinkFor;
  typed: Typed;
  errorsFor: ErrorsFor;
}

const { base, csrf, editable, decisions, editingId, isHit, sourceLink, typed, errorsFor } =
  Astro.props;

const addErrors = errorsFor("add_decision", "text");
---

<section class="panel review-lists" id="decisions" aria-labelledby="decisions-heading">
  <h2 id="decisions-heading">{t("Decisions")}</h2>
  {decisions.length === 0 && <p>{t("No decisions were recorded.")}</p>}
  {decisions.length > 0 && (
    <ul class="rl-list rl-bullets">
      {decisions.map((d) => {
        const errors = errorsFor(d.id, "text");
        const editing = editable && (editingId === d.id || errors.length > 0);
        return (
          <li
            id={`decision-${d.id}`}
            class:list={["rl-item", { "is-hit": isHit("decision", d.id), "is-editing": editing }]}
          >
            {editing ? (
              <>
                <form method="post" action={base} class="form form-wide">
                  <input type="hidden" name="csrf_token" value={csrf} />
                  <input type="hidden" name="intent" value="edit_decision" />
                  <input type="hidden" name="id" value={d.id} />
                  <div class="field field-wide">
                    <label for={`decision-text-${d.id}`}>{t("Decision")}</label>
                    <input
                      id={`decision-text-${d.id}`}
                      name="text"
                      type="text"
                      maxlength="2000"
                      value={typed(d.id, "text", d.text)}
                      aria-invalid={errors.length > 0 ? "true" : undefined}
                      aria-describedby={errors.length > 0 ? `decision-error-${d.id}` : undefined}
                      autofocus
                    />
                    {errors.map((e) => (
                      <p class="field-error" id={`decision-error-${d.id}`}>
                        {e.message}
                      </p>
                    ))}
                  </div>
                  <div class="row-actions">
                    <button class="button" type="submit">
                      {t("Save decision")}
                      <span class="sr-only">{t(": {text}", { text: d.text })}</span>
                    </button>
                    <a href={`${base}#decision-${d.id}`}>
                      {t("Cancel")}
                      <span class="sr-only"> {t("editing this decision")}</span>
                    </a>
                  </div>
                </form>
                <details class="rl-remove">
                  <summary>{t("Remove this decision")}</summary>
                  <form method="post" action={base} class="form">
                    <input type="hidden" name="csrf_token" value={csrf} />
                    <input type="hidden" name="intent" value="delete_decision" />
                    <input type="hidden" name="id" value={d.id} />
                    <p class="help">
                      {t("Removes only this decision from the draft. The transcript is untouched.")}
                    </p>
                    <div class="row-actions">
                      <button class="button button-danger" type="submit">
                        {t("Confirm: remove decision")}
                      </button>
                    </div>
                  </form>
                </details>
              </>
            ) : (
              <div class="rl-line">
                <span class="rl-text">{d.text}</span>
                <span class="rl-meta">
                  {isHit("decision", d.id) && <span class="badge">{t("Search match")}</span>}
                  <ReviewSource source={sourceLink(d.sourceFrom, d.sourceTo)} chip />
                  {d.edited && <span class="rl-chip">{t("Edited by you")}</span>}
                  {editable && (
                    <a class="rl-edit" href={`${base}?edit=${d.id}#decision-${d.id}`}>
                      {t("Edit")}
                      <span class="sr-only"> {t("decision: {text}", { text: d.text })}</span>
                    </a>
                  )}
                </span>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  )}
  {editable && (
    <details class="rl-add" open={addErrors.length > 0}>
      <summary>{t("Add a decision")}</summary>
      <form method="post" action={base} class="form form-wide">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="intent" value="add_decision" />
        <div class="field field-wide">
          <label for="new-decision">{t("Decision")}</label>
          <input
            id="new-decision"
            name="text"
            type="text"
            maxlength="2000"
            value={typed("add_decision", "text", "")}
            aria-invalid={addErrors.length > 0 ? "true" : undefined}
            aria-describedby={addErrors.length > 0 ? "new-decision-error" : undefined}
          />
          {addErrors.map((e) => (
            <p class="field-error" id="new-decision-error">
              {e.message}
            </p>
          ))}
        </div>
        <div class="row-actions">
          <button class="button button-quiet" type="submit">
            {t("Add decision")}
          </button>
        </div>
      </form>
    </details>
  )}
</section>

<script>
  import "../../scripts/review-lists";
</script>
