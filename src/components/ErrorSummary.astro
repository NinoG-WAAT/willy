---
import type { FieldError } from "../domain/platform/text";

interface Props {
  errors: FieldError[];
}

const { errors } = Astro.props;
---

{errors.length > 0 && (
  <div class="alert" role="alert" id="form-errors">
    <p>Fix the following before continuing:</p>
    <ul>
      {errors.map((e) => (
        <li>
          <a href={`#${e.field}`}>{e.message}</a>
        </li>
      ))}
    </ul>
  </div>
)}
