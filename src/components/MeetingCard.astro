---
import { consentLabel, describeMeeting } from "../domain/meetings/home";
import type { MeetingListItem } from "../domain/meetings/list-item";
import { formatSchedule } from "./format-schedule";

interface Props {
  item: MeetingListItem;
}

const { item } = Astro.props;
const description = describeMeeting(item);
// A meeting still being processed is watched for progress (src/scripts/job-progress.ts).
const watching = item.status === "processing";
const attendees = `${String(item.attendeeCount)} ${item.attendeeCount === 1 ? "attendee" : "attendees"}`;
---

<li
  class="row meeting"
  data-progress={watching ? "card" : undefined}
  data-progress-url={watching ? `/api/meetings/${item.id}/status` : undefined}
  data-announce-to={watching ? "progress-announce" : undefined}
  data-meeting-id={watching ? item.id : undefined}
  data-title={watching ? item.title : undefined}
>
  <h3 class="row-title">
    <a href={description.href}>{item.title}</a>
  </h3>
  <p class="row-meta">
    <time datetime={item.scheduledStartAt}>
      {formatSchedule(item.scheduledStartAt, item.timezone)}
    </time>
    {item.attendeeCount > 0 && <span> · {attendees}</span>}
    {item.calendarProvider !== null && <span> · From your calendar</span>}
  </p>
  <ul class="facts">
    <li>
      <span class="marker" aria-hidden="true" data-field="marker">
        {description.marker}
      </span>
      <span class="fact-label">Status:</span> <span data-field="label">{description.label}</span>
    </li>
    <li>
      <span class="fact-label">Consent:</span> {consentLabel(item)}
    </li>
  </ul>
  <div class="row-actions">
    <a class="button" href={description.href}>
      <span data-field="action">{description.actionLabel}</span>
      <span class="sr-only"> for {item.title}</span>
    </a>
  </div>
</li>
