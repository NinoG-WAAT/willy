---
import { canBeAutoCorrected } from "../../domain/transcription/vocabulary";
import { t } from "../../i18n/translate";
import type { VocabularyTerm } from "../../ports/vocabulary-repository";

/**
 * The owner's words as a plain outline: the text, and Remove on the same line when there is
 * room. Left-out words are marked in words ("Not sent"), never by colour or position alone. Every
 * word is a text node: nothing here is ever raw HTML.
 */
interface Props {
  terms: readonly VocabularyTerm[];
  csrf: string;
  /** True for the group that does not fit the speech recogniser's prompt. */
  leftOut?: boolean;
  labelledBy: string;
}

const { terms, csrf, leftOut = false, labelledBy } = Astro.props;
---

<ul class="rl-list vocabulary-list" aria-labelledby={labelledBy}>
  {terms.map((entry) => (
    <li class="rl-item" id={`term-${entry.id}`}>
      <div class="rl-line">
        <span class="rl-text">{entry.term}</span>
        <span class="rl-meta">
          {leftOut && <span class="rl-chip">{t("Not sent")}</span>}
          {!canBeAutoCorrected(entry.term) && (
            <span class="rl-chip">{t("Not auto-corrected in transcripts")}</span>
          )}
          <form
            class="inline-form"
            method="post"
            action={`/settings/vocabulary/${encodeURIComponent(entry.id)}/remove`}
          >
            <input type="hidden" name="csrf_token" value={csrf} />
            <button class="vocabulary-remove" type="submit">
              {t("Remove")}
              <span class="sr-only"> {entry.term}</span>
            </button>
          </form>
        </span>
      </div>
    </li>
  ))}
</ul>
