---
// Small line icons for the shell (16px grid, stroked with the text colour). Always decorative:
// every item that uses one also has its word, so the icon is hidden from assistive technology.
interface Props {
  name: "home" | "search" | "folder" | "more";
}

const PATHS = {
  home: "M2 9l2-6h8l2 6v4H2zM2 9h3.5l1 1.5h3L11 9h3",
  search: "M7 2.5a4.5 4.5 0 1 0 0 9a4.5 4.5 0 0 0 0-9zM10.5 10.5L14 14",
  folder: "M2 4h4l1.5 1.5H14v7H2z",
  more: "M3 5h10M3 8h10M3 11h10",
} as const;

const { name } = Astro.props;
---

<svg class="icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path d={PATHS[name]}></path>
</svg>
