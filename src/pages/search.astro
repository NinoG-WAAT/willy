---
import Base from "../layouts/Base.astro";
import { requireOwner } from "../app/identity/require-owner";
import { searchNotes } from "../app/search/search";
import { formatSchedule } from "../components/format-schedule";
import { getNotesDeps, getSearchDeps } from "../composition";
import { hitHref, hitKindLabel } from "../domain/search/hit-link";
import { t, tn } from "../i18n/translate";

export const prerender = false;

// Owner route (middleware default-deny). GET only: searching never changes anything.
const owner = requireOwner(Astro.locals);
Astro.response.headers.set("Cache-Control", "no-store");

const params = Astro.url.searchParams;
const rawQuery = params.get("q");
const folderParam = params.get("folder");
const folderId =
  folderParam !== null && folderParam !== "" && folderParam.length <= 100 ? folderParam : null;
const includeArchived = params.get("archived") === "1";
const folders = await getNotesDeps().folders.list(owner.id);

let error: string | null = null;
let result: Awaited<ReturnType<typeof searchNotes>> | null = null;

// The per-owner rate limit for /search is enforced by the middleware (docs/OPERATIONS.md).
if (rawQuery !== null) {
  result = await searchNotes(getSearchDeps(), owner.id, { q: rawQuery, folderId, includeArchived });
  if (!result.ok) {
    error = result.error.message;
    Astro.response.status = 422;
  }
}

const hits = result?.ok ? result.value.hits : [];
const terms = result?.ok ? result.value.terms : [];
const queryText = terms.join(" ");
const pageName =
  rawQuery !== null && rawQuery.trim() !== ""
    ? t("Search: {terms}", { terms: queryText || rawQuery.slice(0, 40) })
    : t("Search");
const resultsSummary =
  hits.length === 0
    ? t(
        'No results for "{terms}". Check the spelling, try fewer words, or include archived meetings.',
        { terms: queryText },
      )
    : tn('{n} result for "{terms}".', '{n} results for "{terms}".', hits.length, {
        terms: queryText,
      });
---

<Base title={pageName}>
  <h1>{t("Search")}</h1>
  <p>
    {t(
      "Search the titles, agendas, rough notes, summaries, decisions and action items of your own meetings. Transcripts are not searched.",
    )}
  </p>

  <form class="toolbar" role="search" method="get" action="/search">
    <div class="field">
      <label for="q">{t("Search your notes")}</label>
      <input
        id="q"
        name="q"
        type="search"
        required
        maxlength="200"
        value={rawQuery ?? ""}
        aria-invalid={error !== null ? "true" : undefined}
        aria-describedby={error !== null ? "q-error" : undefined}
      />
      {error !== null && (
        <p class="field-error" id="q-error">
          {error}
        </p>
      )}
    </div>
    <div class="field">
      <label for="folder">{t("Folder")}</label>
      <select id="folder" name="folder">
        <option value="">{t("All folders")}</option>
        {folders.map((f) => (
          <option value={f.id} selected={f.id === folderId}>
            {f.name}
          </option>
        ))}
      </select>
    </div>
    <div class="check">
      <input id="archived" name="archived" type="checkbox" value="1" checked={includeArchived} />
      <label for="archived">{t("Include archived")}</label>
    </div>
    <button class="button button-primary" type="submit">
      {t("Search")}
    </button>
  </form>

  {rawQuery === null && (
    <section class="empty" aria-labelledby="hint-heading">
      <h2 id="hint-heading">{t("Find something you wrote or decided")}</h2>
      <p>
        {t(
          "Type a few words, for example a person, a project or a decision. Results show where the words appear.",
        )}
      </p>
    </section>
  )}

  {result?.ok && (
    <section aria-labelledby="results-heading">
      <h2 id="results-heading">{t("Results")}</h2>
      <p role="status" aria-live="polite">
        {resultsSummary}
      </p>
      {hits.length > 0 && (
        <ol class="rows">
          {hits.map((hit) => (
            <li class="row hit">
              <h3 class="row-title">
                <a href={hitHref(hit, queryText)}>{hit.meetingTitle}</a>
              </h3>
              <p class="row-meta">
                {hit.kind === "note_section"
                  ? t("{kind}: {label}", { kind: hitKindLabel(hit.kind), label: hit.label })
                  : hitKindLabel(hit.kind)}
                {" · "}
                <time datetime={hit.scheduledStartAt}>
                  {formatSchedule(hit.scheduledStartAt, hit.timezone)}
                </time>
                {hit.folderName !== null && (
                  <span>
                    {" · "}
                    {t("Folder: {name}", { name: hit.folderName })}
                  </span>
                )}
              </p>
              <p class="snippet">
                {hit.segments.map((segment) =>
                  segment.hit ? <mark>{segment.text}</mark> : segment.text,
                )}
              </p>
              <div class="row-actions">
                <a href={hitHref(hit, queryText)}>
                  {t("Open")}
                  <span class="sr-only"> {hit.meetingTitle}</span>
                </a>
                <a href={`/meetings/${hit.meetingId}/export.md`} download>
                  {t("Export Markdown")}
                  <span class="sr-only"> {t("of {title}", { title: hit.meetingTitle })}</span>
                </a>
              </div>
            </li>
          ))}
        </ol>
      )}
    </section>
  )}
</Base>
