---
import Base from "../../../layouts/Base.astro";
import MeetingHeader from "../../../components/MeetingHeader.astro";
import { requireOwner } from "../../../app/identity/require-owner";
import ReviewActionItems from "../../../components/review/ReviewActionItems.astro";
import ReviewDecisions from "../../../components/review/ReviewDecisions.astro";
import ReviewMoveFolder from "../../../components/review/ReviewMoveFolder.astro";
import ReviewPublish from "../../../components/review/ReviewPublish.astro";
import ReviewSpeakers from "../../../components/review/ReviewSpeakers.astro";
import ReviewSummary from "../../../components/review/ReviewSummary.astro";
import ReviewTranscript from "../../../components/review/ReviewTranscript.astro";
import type { Checked, ErrorsFor, SourceLinkFor, Typed } from "../../../components/review/types";
import { loadReviewPage } from "../../../app/notes/review";
import { handleReviewForm, reviewNoticeText } from "../../../app/notes/review-http";
import { getProcessingStatus } from "../../../app/transcription/processing-status";
import { getReviewDeps, getStatusDeps } from "../../../composition";
import { formatOffset, resolveHighlight } from "../../../domain/notes/review";
import type { HighlightableItem } from "../../../domain/notes/review";
import { describeJob } from "../../../domain/progress/text";
import { isValidStorageId } from "../../../domain/storage/object-key";

export const prerender = false;

const owner = requireOwner(Astro.locals);
Astro.response.headers.set("Cache-Control", "no-store");

const id = Astro.params.id ?? "";
// An id that cannot exist looks exactly like another owner's: the same 404.
if (!isValidStorageId(id)) return Astro.rewrite("/404");

const deps = getReviewDeps();
const base = `/meetings/${id}/review`;
let problem: Extract<Awaited<ReturnType<typeof handleReviewForm>>, { kind: "problem" }> | null =
  null;

if (Astro.request.method === "POST") {
  // A clone: a rewrite to the 404 page re-reads the request, whose body must still be unread.
  const form = await Astro.request.clone().formData();
  const result = await handleReviewForm(deps, owner.id, id, form);
  switch (result.kind) {
    case "redirect":
      return Astro.redirect(
        `${base}?notice=${result.notice}${result.anchor === null ? "" : `#${result.anchor}`}`,
        303,
      );
    case "not_found":
      return Astro.rewrite("/404");
    case "bad_request":
      return new Response("Bad request", { status: 400 });
    case "problem":
      problem = result;
      Astro.response.status = result.status;
  }
}

const loaded = await loadReviewPage(deps.review, owner.id, id);
if (!loaded.ok) {
  // Nothing to review yet: the live note is where this meeting lives.
  return loaded.error.kind === "not_ready"
    ? Astro.redirect(`/meetings/${id}`, 303)
    : Astro.rewrite("/404");
}
const { view, segments, folders, editable } = loaded.value;
const { meeting, note } = view;
const status = await getProcessingStatus(getStatusDeps(), owner.id, id);
const progress = status.ok ? status.value : null;
const now = deps.review.clock.now();
const csrf = Astro.locals.csrfToken ?? "";

const items: HighlightableItem[] = [
  ...view.sections.map((s) => ({
    kind: "note_section" as const,
    id: s.id,
    sourceFrom: s.sourceFrom,
    sourceTo: s.sourceTo,
  })),
  ...view.decisions.map((d) => ({
    kind: "decision" as const,
    id: d.id,
    sourceFrom: d.sourceFrom,
    sourceTo: d.sourceTo,
  })),
  ...view.actionItems.map((a) => ({
    kind: "action_item" as const,
    id: a.id,
    sourceFrom: a.sourceFrom,
    sourceTo: a.sourceTo,
  })),
];
const highlight = resolveHighlight(
  { src: Astro.url.searchParams.get("src"), hit: Astro.url.searchParams.get("hit") },
  items,
);
const isHit = (kind: string, itemId: string) =>
  highlight.hit?.kind === kind && highlight.hit.id === itemId;
const inSource = (position: number) =>
  highlight.range !== null && position >= highlight.range.from && position <= highlight.range.to;

const startOf = new Map(segments.map((s) => [s.position, s.startMs]));
const sourceLink: SourceLinkFor = (from, to) => {
  if (from === null || to === null) return null;
  const a = startOf.get(from);
  const b = startOf.get(to);
  const label =
    a === undefined || b === undefined
      ? "Source in the transcript"
      : `Source: transcript ${formatOffset(a)} to ${formatOffset(b)}`;
  return { label, href: `${base}?src=${String(from)}-${String(to)}#seg-${String(from)}`, from, to };
};

const speakers = [...new Set(segments.map((s) => s.speaker))].map((name) => ({
  name,
  lines: segments.filter((s) => s.speaker === name).length,
}));

const echo = problem?.echo ?? null;
const typed: Typed = (key, name, fallback) =>
  echo?.itemId === key ? (echo.values[name] ?? "") : fallback;
const errorsFor: ErrorsFor = (key, field) =>
  problem !== null && echo?.itemId === key ? problem.errors.filter((e) => e.field === field) : [];
const checked: Checked = (key, name, fallback) =>
  echo?.itemId === key ? name in echo.values : fallback;

// The move notices name the folder the note is in now: read from the database, never the URL.
const notice = reviewNoticeText(Astro.url.searchParams.get("notice"), note?.folderName ?? null);
// Only a Published note moves; the control lists the owner's other folders.
const canMove = meeting.status === "published" && note?.status === "published";
const moveTargets = folders.filter((f) => f.id !== note?.folderId);
const moveErrors = errorsFor("move_note", "folder");

const regeneration = progress?.regeneration ?? null;
// The whole-draft request has no section; its line stays until it is done.
const draftRegeneration =
  regeneration !== null && regeneration.sectionId === null && regeneration.status !== "succeeded"
    ? regeneration
    : null;
---

<Base
  title={`Review: ${meeting.title}`}
  noteFolderId={note?.status === "published" ? note.folderId : null}
>
  <MeetingHeader
    page="review"
    meeting={meeting}
    noteStatus={note?.status ?? null}
    folder={
      note?.folderId != null && note.folderName !== null
        ? { id: note.folderId, name: note.folderName }
        : null
    }
    template={meeting.template}
  >
    {canMove && (
      <ReviewMoveFolder
        slot="move"
        base={base}
        csrf={csrf}
        moveTargets={moveTargets}
        moveErrors={moveErrors}
      />
    )}
    <a slot="links" href={`/meetings/${meeting.id}/export.md`} download>
      Export as Markdown<span class="sr-only"> ({meeting.title})</span>
    </a>
    <a slot="links" href={`/meetings/${meeting.id}`}>
      Rough notes
    </a>
  </MeetingHeader>

  {notice !== null && (
    <p class="notice" role="status">
      {notice}
    </p>
  )}
  {problem !== null && (
    <div class="alert" role="alert">
      <p>{problem.message}</p>
    </div>
  )}
  <p id="source-status" class="sr-only" role="status" aria-live="polite"></p>

  {meeting.status === "processing" && (
    <section class="panel" aria-labelledby="pending-heading">
      <h2 id="pending-heading">Your transcript and summary are being prepared</h2>
      <div
        id="processing-progress"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        data-progress="processing"
        data-progress-url={`/api/meetings/${id}/status`}
      >
        <ul class="plain">
          <li data-field="transcript">Transcript: {describeJob(progress?.job ?? null)}</li>
          <li data-field="summary">Summary: {describeJob(progress?.summary ?? null)}</li>
        </ul>
        <p data-field="outcome" data-optional hidden></p>
      </div>
      <p class="help">
        This can take a few minutes. <a href={base}>Check again</a>. Your rough notes are kept
        below.
      </p>
    </section>
  )}

  {meeting.status === "failed" && (
    <section class="panel" aria-labelledby="failed-heading">
      <h2 id="failed-heading">Transcription did not finish</h2>
      <p class="alert" role="alert">
        {describeJob(progress?.job ?? null)}. Nothing you wrote was lost.
      </p>
      <form method="post" action={base} class="form form-wide">
        <input type="hidden" name="csrf_token" value={csrf} />
        <input type="hidden" name="intent" value="retry_transcription" />
        <p class="help">
          Retrying redoes only the parts that failed and never duplicates transcript lines.
        </p>
        <div class="row-actions">
          <button class="button button-primary" type="submit">
            Retry transcription
          </button>
        </div>
      </form>
    </section>
  )}

  {note === null && (
    <section class="panel" aria-labelledby="rough-heading">
      <h2 id="rough-heading">Your rough notes</h2>
      {meeting.roughNotes === "" ? (
        <p>You did not take rough notes.</p>
      ) : (
        <p class="prewrap">{meeting.roughNotes}</p>
      )}
    </section>
  )}

  {note !== null && (
    <div class="two-col review-grid">
      <div id="summary">
        <p>
          <a class="jump-link" href="#transcript">
            Jump to the transcript
          </a>
        </p>

        <ReviewPublish
          base={base}
          csrf={csrf}
          editable={editable}
          note={note}
          meeting={meeting}
          folders={folders}
          typed={typed}
          errorsFor={errorsFor}
        />

        <ReviewSummary
          meetingId={meeting.id}
          base={base}
          csrf={csrf}
          editable={editable}
          sections={view.sections}
          regeneration={regeneration}
          draftRegeneration={draftRegeneration}
          isHit={isHit}
          sourceLink={sourceLink}
          typed={typed}
          errorsFor={errorsFor}
        />

        <ReviewDecisions
          base={base}
          csrf={csrf}
          editable={editable}
          decisions={view.decisions}
          isHit={isHit}
          sourceLink={sourceLink}
          typed={typed}
          errorsFor={errorsFor}
        />

        <ReviewActionItems
          base={base}
          csrf={csrf}
          editable={editable}
          actionItems={view.actionItems}
          attendees={view.attendees}
          timezone={meeting.timezone}
          now={now}
          isHit={isHit}
          sourceLink={sourceLink}
          typed={typed}
          checked={checked}
          errorsFor={errorsFor}
        />
      </div>

      <aside class="review-transcript" id="transcript" aria-labelledby="transcript-heading">
        <ReviewSpeakers
          base={base}
          csrf={csrf}
          editable={editable}
          speakers={speakers}
          typed={typed}
          errorsFor={errorsFor}
        />
        <ReviewTranscript segments={segments} inSource={inSource} />
      </aside>
    </div>
  )}

  {note === null && segments.length > 0 && (
    <section class="panel" aria-labelledby="lines-heading-alone">
      <h2 id="lines-heading-alone">Transcript so far</h2>
      <ol class="transcript">
        {segments.map((s) => (
          <li id={`seg-${s.position}`}>
            <span class="seg-time">{formatOffset(s.startMs)}</span> <strong>{s.speaker}</strong>
            <span class="sr-only">:</span>
            {s.text === null ? <em>This line could not be read.</em> : s.text}
          </li>
        ))}
      </ol>
    </section>
  )}

  <script>
    import "../../../scripts/review";
    import "../../../scripts/job-progress";
  </script>
</Base>
