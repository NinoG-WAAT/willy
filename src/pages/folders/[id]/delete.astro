---
import Base from "../../../layouts/Base.astro";
import { requireOwner } from "../../../app/identity/require-owner";
import { deleteFolder, findFolderForDelete } from "../../../app/notes/folders";
import { readFormFields } from "../../../app/platform/form";
import { getNotesDeps } from "../../../composition";
import { t, tn } from "../../../i18n/translate";

export const prerender = false;

const owner = requireOwner(Astro.locals);
const deps = getNotesDeps();
Astro.response.headers.set("Cache-Control", "no-store");

const id = Astro.params.id ?? "";
// Same 404 for a missing folder and for another owner's folder.
const found = await findFolderForDelete(deps, owner.id, id);
if (!found.ok) return Astro.rewrite("/404");

let blockedMessage: string | null = null;
if (Astro.request.method === "POST") {
  if (!readFormFields(await Astro.request.clone().formData(), ["csrf_token", "confirm"])) {
    return new Response("Bad request", { status: 400 });
  }
  const result = await deleteFolder(deps, owner.id, id);
  if (result.ok) return Astro.redirect("/folders?notice=folder_deleted", 303);
  if (result.error.kind === "not_found") return Astro.rewrite("/404");
  blockedMessage = result.error.kind === "blocked" ? result.error.message : null;
  Astro.response.status = 409;
}

const folder = found.value;
const blocked = blockedMessage ?? (folder.noteCount > 0 ? "blocked" : null);
---

<Base title={t("Delete folder {name}", { name: folder.name })}>
  <h1>{t("Delete folder")}</h1>
  <p>{t("You are about to delete the folder {name}.", { name: folder.name })}</p>
  <p>
    {t(
      "Scope: only the folder itself is removed. Notes are never deleted by this action, which is why a folder that still contains notes cannot be deleted.",
    )}
  </p>
  <p>{tn("This folder contains {n} note.", "This folder contains {n} notes.", folder.noteCount)}</p>

  {blockedMessage !== null && (
    <p class="alert" role="alert">
      {blockedMessage}
    </p>
  )}

  {blocked !== null ? (
    <p>
      <a class="button button-quiet" href="/folders">
        {t("Back to folders")}
      </a>
    </p>
  ) : (
    <form class="row-actions" method="post" action={`/folders/${folder.id}/delete`}>
      <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken ?? ""} />
      <button class="button button-danger" type="submit">
        {t("Delete folder")}
      </button>
      <a href="/folders">{t("Cancel")}</a>
    </form>
  )}
</Base>
