---
import Base from "../../../../layouts/Base.astro";
import { requireOwner } from "../../../../app/identity/require-owner";
import { deleteTemplate, findTemplate } from "../../../../app/notes/templates";
import { readFormFields } from "../../../../app/platform/form";
import { getNotesDeps } from "../../../../composition";
import { t, tn } from "../../../../i18n/translate";

export const prerender = false;

const owner = requireOwner(Astro.locals);
const deps = getNotesDeps();
Astro.response.headers.set("Cache-Control", "no-store");

const id = Astro.params.id ?? "";
const found = await findTemplate(deps, owner.id, id);
if (!found.ok) return Astro.rewrite("/404");

if (Astro.request.method === "POST") {
  if (!readFormFields(await Astro.request.clone().formData(), ["csrf_token", "confirm"])) {
    return new Response("Bad request", { status: 400 });
  }
  const result = await deleteTemplate(deps, owner.id, id);
  if (!result.ok) return Astro.rewrite("/404");
  return Astro.redirect("/settings/templates?notice=template_deleted", 303);
}

const template = found.value;
---

<Base title={t("Delete template {name}", { name: template.name })}>
  <h1>{t("Delete template")}</h1>
  <p>{t("You are about to delete the template {name}.", { name: template.name })}</p>
  <p>
    {tn(
      "Scope: the template and its {n} section are removed. Meetings and notes are never deleted by this action.",
      "Scope: the template and its {n} sections are removed. Meetings and notes are never deleted by this action.",
      template.sections.length,
    )}
  </p>
  <p>
    {template.meetingCount === 0
      ? t("No meeting uses this template.")
      : tn(
          "{n} meeting uses this template. They keep their notes and fall back to your default template when a summary is regenerated.",
          "{n} meetings use this template. They keep their notes and fall back to your default template when a summary is regenerated.",
          template.meetingCount,
        )}
    {template.isDefault && (
      <>
        {" "}
        {t("It is your default template, so new notes will use the built-in layout afterwards.")}
      </>
    )}
  </p>
  <form class="row-actions" method="post" action={`/settings/templates/${template.id}/delete`}>
    <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken ?? ""} />
    <button class="button button-danger" type="submit">
      {t("Delete template")}
    </button>
    <a href="/settings/templates">{t("Cancel")}</a>
  </form>
</Base>
