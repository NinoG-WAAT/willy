---
import Base from "../../../layouts/Base.astro";
import { requireOwner } from "../../../app/identity/require-owner";
import { noticeText } from "../../../app/notes/notices";
import { listTemplates, setDefaultTemplate } from "../../../app/notes/templates";
import { readFormFields, single } from "../../../app/platform/form";
import { getNotesDeps } from "../../../composition";
import { t, tn } from "../../../i18n/translate";
import { builtinTemplate } from "../../../domain/notes/template";

export const prerender = false;

const owner = requireOwner(Astro.locals);
const deps = getNotesDeps();
Astro.response.headers.set("Cache-Control", "no-store");

if (Astro.request.method === "POST") {
  const fields = readFormFields(await Astro.request.clone().formData(), [
    "csrf_token",
    "intent",
    "id",
  ]);
  if (!fields || single(fields, "intent") !== "set_default") {
    return new Response("Bad request", { status: 400 });
  }
  const result = await setDefaultTemplate(deps, owner.id, single(fields, "id") ?? "");
  if (!result.ok) return Astro.rewrite("/404");
  return Astro.redirect("/settings/templates?notice=template_default", 303);
}

const templates = await listTemplates(deps, owner.id);
const notice = noticeText(Astro.url.searchParams.get("notice"));
const hasDefault = templates.some((template) => template.isDefault);
// The built-in layout in the owner's language: the headings new notes will actually get.
const builtInSections = builtinTemplate()
  .sections.map((s) => s.heading)
  .join(", ");
---

<Base title={t("Templates")}>
  <div class="page-head">
    <h1>{t("Templates")}</h1>
    <a class="button button-primary" href="/settings/templates/new">
      {t("New template")}
    </a>
  </div>
  <p>
    {t(
      "A template lists the sections of the note generated after a meeting, for example a weekly sync or a customer call. Pick one when you create a meeting, or set a default.",
    )}
  </p>

  {notice !== null && (
    <p class="notice" role="status">
      {notice}
    </p>
  )}

  {templates.length === 0 ? (
    <p>
      {t(
        "You have no templates yet. Until you create one, new notes use the built-in layout: {sections}.",
        {
          sections: builtInSections,
        },
      )}
    </p>
  ) : (
    <>
      {!hasDefault && (
        <p>
          {t(
            "None of your templates is the default, so new notes use the built-in layout: {sections}.",
            {
              sections: builtInSections,
            },
          )}
        </p>
      )}
      <ul class="rows">
        {templates.map((template) => (
          <li class="row">
            <h2>
              {template.name} {template.isDefault && <span class="badge">{t("Default")}</span>}
            </h2>
            <p class="row-meta">
              {tn(
                "{n} section: {headings}.",
                "{n} sections: {headings}.",
                template.sections.length,
                {
                  headings: template.sections.map((s) => s.heading).join(", "),
                },
              )}{" "}
              {tn("Used by {n} meeting.", "Used by {n} meetings.", template.meetingCount)}
            </p>
            <div class="row-actions">
              <a href={`/settings/templates/${template.id}`}>
                {t("Edit")}
                <span class="sr-only"> {t("template {name}", { name: template.name })}</span>
              </a>
              {!template.isDefault && (
                <form method="post" action="/settings/templates">
                  <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken ?? ""} />
                  <input type="hidden" name="intent" value="set_default" />
                  <input type="hidden" name="id" value={template.id} />
                  <button class="button button-quiet" type="submit">
                    {t("Make default")}
                    <span class="sr-only"> {t("template {name}", { name: template.name })}</span>
                  </button>
                </form>
              )}
              <a href={`/settings/templates/${template.id}/delete`}>
                {t("Delete")}
                <span class="sr-only"> {t("template {name}", { name: template.name })}</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </>
  )}
</Base>
