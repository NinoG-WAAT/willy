---
import Base from "../../../layouts/Base.astro";
import ErrorSummary from "../../../components/ErrorSummary.astro";
import VocabularyAdd from "../../../components/vocabulary/VocabularyAdd.astro";
import VocabularyList from "../../../components/vocabulary/VocabularyList.astro";
import { requireOwner } from "../../../app/identity/require-owner";
import { readFormFields, single } from "../../../app/platform/form";
import { settingsNotice } from "../../../app/settings/notices";
import { addVocabularyTerms, listVocabulary } from "../../../app/transcription/vocabulary";
import { getVocabularyDeps } from "../../../composition";
import type { FieldError } from "../../../domain/platform/text";
import {
  canBeAutoCorrected,
  describeVocabularyStatus,
} from "../../../domain/transcription/vocabulary";

export const prerender = false;

// Owner route: the middleware has verified session, Origin and CSRF. The owner id comes from the
// session only. Words are shown as text and never logged.
const owner = requireOwner(Astro.locals);
const deps = getVocabularyDeps();
Astro.response.headers.set("Cache-Control", "no-store");

let errors: FieldError[] = [];
let typed = "";

if (Astro.request.method === "POST") {
  const fields = readFormFields(await Astro.request.clone().formData(), ["csrf_token", "term"]);
  if (!fields) return new Response("Bad request", { status: 400 });
  typed = single(fields, "term") ?? "";
  const result = await addVocabularyTerms(deps, owner.id, single(fields, "term"));
  if (result.ok) {
    const code = result.value.added > 0 ? "vocabulary_added" : "vocabulary_unchanged";
    return Astro.redirect(`/settings/vocabulary?notice=${code}`, 303);
  }
  if (result.error.kind !== "invalid") return Astro.rewrite("/404");
  errors = result.error.errors;
  Astro.response.status = 422;
}

const view = await listVocabulary(deps, owner.id);
const used = view.terms.slice(0, view.usedCount);
const notice = settingsNotice(Astro.url.searchParams.get("notice"));
const csrf = Astro.locals.csrfToken ?? "";
const status = describeVocabularyStatus(view.terms.length, view.usedCount);
---

<Base title="Vocabulary">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol>
      <li>
        <a href="/settings">Settings</a>
      </li>
      <li>
        <span aria-current="page">Vocabulary</span>
      </li>
    </ol>
  </nav>
  <div class="page-head">
    <h1>Vocabulary</h1>
  </div>

  {notice !== null && (
    <p class="notice" role="status">
      {notice}
    </p>
  )}
  <ErrorSummary errors={errors} />

  <section class="panel review-lists vocabulary" aria-labelledby="vocabulary-heading">
    <h2 id="vocabulary-heading">Your words</h2>
    <p class="help">
      Words your meetings use that a speech recogniser does not know: project names, clients,
      acronyms. They are given to it before it transcribes, so it spells them the way you do.
    </p>

    {view.terms.length === 0 ? (
      <p class="vocabulary-empty">
        No words yet. Add the names a transcript tends to get wrong, such as a product or a client.
      </p>
    ) : (
      <>
        <p class="vocabulary-status">{status}</p>
        {view.terms.some((t) => !canBeAutoCorrected(t.term)) && (
          <p class="help">
            A word marked "Not auto-corrected in transcripts" (it has a dot, a symbol or another
            sign that is not a letter, digit, space, hyphen or apostrophe) still helps the speech
            recogniser, but its spelling is not fixed afterwards in the transcript.
          </p>
        )}
        {used.length > 0 && (
          <>
            <h3 id="vocabulary-used" class="sr-only">
              Used by the speech recogniser
            </h3>
            <VocabularyList terms={used} csrf={csrf} labelledBy="vocabulary-used" />
          </>
        )}
        {view.leftOut.length > 0 && (
          <>
            <h3 id="vocabulary-left-out">Left out</h3>
            <p class="help">
              The speech recogniser can read only about 600 characters of words, in the order of
              this list. These come last and do not fit. Remove words above to make room, or remove
              these.
            </p>
            <VocabularyList
              terms={view.leftOut}
              csrf={csrf}
              leftOut
              labelledBy="vocabulary-left-out"
            />
          </>
        )}
      </>
    )}

    <VocabularyAdd
      csrf={csrf}
      errors={errors}
      typed={typed}
      open={view.terms.length === 0}
      maxTerms={view.maxTerms}
    />
  </section>
</Base>
