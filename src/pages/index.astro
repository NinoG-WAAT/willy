---
import Base from "../layouts/Base.astro";
import NoteList from "../components/NoteList.astro";
import { requireOwner } from "../app/identity/require-owner";
import { loadInbox } from "../app/meetings/inbox";
import { noticeMessage, problemMessage } from "../app/meetings/messages";
import { getInboxDeps } from "../composition";
import type { InboxSection } from "../ports/note-list";

export const prerender = false;

// Owner route (middleware default-deny). The owner id comes from the session only. Status decides
// place: this page lists what needs the owner; published notes live in folders (/folders/:id).
const owner = requireOwner(Astro.locals);
Astro.response.headers.set("Cache-Control", "no-store");

const params = Astro.url.searchParams;
const { sections, folders } = await loadInbox(getInboxDeps(), owner.id);
const notice = noticeMessage(params);
const problem = problemMessage(params.get("problem"));

const more = (section: InboxSection): string | null =>
  section.total > section.items.length
    ? `Showing ${String(section.items.length)} of ${String(section.total)}.`
    : null;
---

<Base title="Inbox">
  <div class="page-head">
    <h1>Inbox</h1>
    <div class="row-actions">
      {/* The shell's New note is the lime action here; this one is the same action, so it is a default button. */}
      <a class="button" href="/meetings/new">
        New note
      </a>
      <form
        method="post"
        action="/meetings/import"
        data-pending-text="Importing from your calendar…"
      >
        <input type="hidden" name="csrf_token" value={Astro.locals.csrfToken ?? ""} />
        <button class="button button-quiet" type="submit">
          Import from calendar
        </button>
      </form>
      <a class="button button-quiet" href="/meetings/import/ics">
        Import from ICS file
      </a>
    </div>
  </div>
  <p class="row-meta">What needs you: published notes are in your folders and in All notes.</p>

  <p id="pending-status" class="sr-only" role="status"></p>
  <p id="progress-announce" class="sr-only" role="status" aria-live="polite"></p>
  {notice !== null && (
    <p class="notice" role="status">
      {notice}
    </p>
  )}
  {problem !== null && (
    <p class="alert" role="alert">
      {problem}
    </p>
  )}

  {folders.length > 0 && (
    <nav class="folder-nav" aria-label="Folders">
      <p class="row-meta">Open a folder</p>
      <ul class="chips">
        {folders.map((f) => (
          <li>
            <a class="chip" href={`/folders/${f.id}`}>
              {f.name}
              <span class="chip-count">
                {f.publishedCount}
                <span class="sr-only"> {f.publishedCount === 1 ? "note" : "notes"}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <div class="toolbar">
    <form class="inline-form" role="search" method="get" action="/search">
      <div class="field">
        <label for="search-q">Search your notes</label>
        <input id="search-q" name="q" type="search" required maxlength="200" />
      </div>
      <button class="button button-quiet" type="submit">
        Search
      </button>
    </form>
  </div>

  <section class="inbox-section" aria-labelledby="in-progress-heading">
    <h2 id="in-progress-heading">In progress</h2>
    {sections.inProgress.items.length === 0 ? (
      <div class="inbox-empty">
        <p>Nothing is recording or being processed.</p>
        <a href="#upcoming-heading">Go to upcoming notes</a>
      </div>
    ) : (
      <NoteList items={sections.inProgress.items} />
    )}
    {more(sections.inProgress) !== null && (
      <p class="section-more">
        {more(sections.inProgress)} <a href="/notes">See all notes</a>
      </p>
    )}
  </section>

  <section class="inbox-section" aria-labelledby="upcoming-heading">
    <h2 id="upcoming-heading">Upcoming</h2>
    {sections.upcoming.items.length === 0 ? (
      <div class="inbox-empty">
        <p>Nothing scheduled.</p>
        <a href="/meetings/new">Create a note</a>
        <a href="/meetings/import/ics">Import a calendar file</a>
      </div>
    ) : (
      <NoteList items={sections.upcoming.items} />
    )}
    {more(sections.upcoming) !== null && (
      <p class="section-more">
        {more(sections.upcoming)} <a href="/notes">See all notes</a>
      </p>
    )}
  </section>

  <section class="inbox-section" aria-labelledby="drafts-heading">
    <h2 id="drafts-heading">Drafts to review</h2>
    {sections.drafts.items.length === 0 ? (
      <div class="inbox-empty">
        <p>No draft is waiting. A note appears here when its transcript has been summarised.</p>
        <a href="/notes">Browse all notes</a>
      </div>
    ) : (
      <NoteList items={sections.drafts.items} />
    )}
    {more(sections.drafts) !== null && (
      <p class="section-more">
        {more(sections.drafts)} <a href="/notes?status=draft">See all drafts</a>
      </p>
    )}
  </section>

  {sections.missed.items.length > 0 && (
    <section class="inbox-section" aria-labelledby="missed-heading">
      <h2 id="missed-heading">Past and not started</h2>
      <NoteList items={sections.missed.items} />
      {more(sections.missed) !== null && (
        <p class="section-more">
          {more(sections.missed)} <a href="/notes">See all notes</a>
        </p>
      )}
    </section>
  )}

  <script>
    import "../scripts/pending-submit";
    import "../scripts/job-progress";
  </script>
</Base>
