# Copy to .env for local development. Never commit .env or real secrets.
# Only names and placeholders belong here. Later issues append their own variables.

# Server binding (Node adapter)
HOST=127.0.0.1
PORT=4321

# Directory for the local SQLite database and fake object storage (tests use a temp dir).
WILLY_DATA_DIR=./data

# Encryption keys for transcripts and provider tokens (envelope encryption, AES-256-GCM).
# Format: id:base64(32 random bytes)[,id2:...]. Generate one with: openssl rand -base64 32
# The active key wraps new records; older ids stay listed so existing records remain readable.
ENCRYPTION_KEYS=key1:REPLACE_WITH_BASE64_32_BYTES
ENCRYPTION_ACTIVE_KEY_ID=key1
