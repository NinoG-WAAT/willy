# Copy to .env for local development. Never commit .env or real secrets.
# Only names and placeholders belong here. Later issues append their own variables.

# Server binding (Node adapter)
HOST=127.0.0.1
PORT=4321

# Directory for the local SQLite database and fake object storage (tests use a temp dir).
WILLY_DATA_DIR=./data

# Encryption keys for transcripts and provider tokens (envelope encryption, AES-256-GCM).
# Format: id:base64(32 random bytes)[,id2:...]. Generate one with: openssl rand -base64 32
# The active key wraps new records; older ids stay listed so existing records remain readable.
ENCRYPTION_KEYS=key1:REPLACE_WITH_BASE64_32_BYTES
ENCRYPTION_ACTIVE_KEY_ID=key1

# Calendar import (#7). "fake" (default) needs nothing else and uses deterministic fixtures.
CALENDAR_PROVIDER=fake
# Required only when CALENDAR_PROVIDER=google. Server-side only: never prefix with PUBLIC_.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Comma separated exact redirect URIs (https, or http only for localhost).
GOOGLE_OAUTH_REDIRECT_URIS=http://localhost:4321/oauth/calendar/callback
# HMAC secret used to verify inbound calendar webhooks (header: t=<unix>,v1=<hex>).
CALENDAR_WEBHOOK_SECRET=change-me-long-random-string
# HMAC secret for the OAuth state parameter.
OAUTH_STATE_SECRET=change-me-another-long-random-string
# Google OAuth tokens are sealed at rest with ENCRYPTION_KEYS / ENCRYPTION_ACTIVE_KEY_ID (above).
